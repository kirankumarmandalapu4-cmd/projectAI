# Database Configuration
DATABASE_URL=sqlite:///./college_rag.db

# Qdrant Vector DB Configuration (leave empty for local folder storage)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=

# LLM Provider Configuration (gemini, openai, openrouter)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Embedding Provider Configuration (gemini, local, openai)
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=models/text-embedding-004

# Security Configuration
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=1440

# Web application
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development

# Storage & Upload Configuration
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20

# RAG Pipeline Settings
TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.3
